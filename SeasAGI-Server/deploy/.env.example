SEASAGI_VERSION=1.0.0

# 生产模式（GIN_MODE=release）下，以下密钥缺失或仍是 change-me 占位值时服务端会拒绝启动。
# 生成方式示例：openssl rand -hex 32
JWT_SECRET=change-me-in-production-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min
# 管理后台密钥（/api/v1/admin/* 鉴权），必须显式配置
ADMIN_SECRET=change-me-admin-secret-32chars-min
# 通道/资源凭证加密密钥，至少 32 字节；缺失时凭证加解密直接失败
SEASAGI_DATA_KEY=change-me-data-key-32bytes-minimum

API_PORT=9318
RELAY_PORT=8318

DB_PATH=/var/lib/seasagi/platform-api.db

RATE_LIMIT_RPM=60
HEALTH_CHECK_INTERVAL_SEC=30
POLICY_CACHE_SEC=60

PLATFORM_API_URL=http://127.0.0.1:9318

# CORS 白名单：逗号分隔、精确匹配；生产环境不允许 "*"。
# 未配置时仅允许本机来源（localhost / 127.0.0.1 / [::1]）。
CORS_ALLOWED_ORIGINS=https://your-domain.com
# 单请求正文上限（字节）：platform-api
MAX_REQUEST_BODY_BYTES=8388608
# 单请求正文上限（字节）：relay-gateway（音频/文件上传需要更大）
RELAY_MAX_REQUEST_BODY_BYTES=67108864

# Trace 保留策略（platform-api 与 relay-gateway 共用）：
# TRACE_RETENTION_DAYS 默认 30，<=0 表示禁用清理；
# TRACE_PURGE_INTERVAL_HOURS 默认 6，<1 按 1 处理。
TRACE_RETENTION_DAYS=30
TRACE_PURGE_INTERVAL_HOURS=6

WEBHOOK_DISPATCHER_INTERVAL_SEC=5
WEBHOOK_MAX_RETRIES=3

GIN_MODE=release

# 服务端公网地址（OAuth 授权跳转/回调在未配置 PUBLIC_BASE_URL 时回退至此地址）
API_BASE_URL=http://localhost:9318

# ===== 第三方 OAuth 登录（可选）=====
# 客户端"注册/登录"支持 Google / GitHub。两组凭证都配置后，客户端才会展示对应按钮。
# 流程：客户端打开本服务端授权跳转页（/api/v1/auth/oauth/start）-> 302 到 Google/GitHub -> 回调本服务端换码签发 JWT。
# PUBLIC_BASE_URL 是浏览器可达的服务端公网地址，用于拼接授权跳转页与第三方回调地址（未配置时回退 API_BASE_URL）。
PUBLIC_BASE_URL=http://localhost:9318
# Google: https://console.cloud.google.com/apis/credentials （Authorized redirect URIs 填 {PUBLIC_BASE_URL}/api/v1/auth/oauth/callback）
# GitHub: https://github.com/settings/developers （Authorization callback URL 填 {PUBLIC_BASE_URL}/api/v1/auth/oauth/callback）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
