SEASAGI_VERSION=1.0.0

JWT_SECRET=change-me-in-production-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min

API_PORT=9318
RELAY_PORT=8318

DB_PATH=/var/lib/seasagi/platform-api.db

RATE_LIMIT_RPM=60
HEALTH_CHECK_INTERVAL_SEC=30
POLICY_CACHE_SEC=60

PLATFORM_API_URL=http://127.0.0.1:9318

CORS_ALLOW_ORIGIN=https://your-domain.com

WEBHOOK_DISPATCHER_INTERVAL_SEC=5
WEBHOOK_MAX_RETRIES=3

GIN_MODE=release

# Stripe 支付
# 从 Stripe Dashboard 获取密钥：https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Stripe Webhook 签名密钥（可选，用于校验回调签名）
# 在 Stripe Dashboard → Webhooks 中创建 endpoint 后获取
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# 服务端公网地址，Stripe 回调时会重定向到此地址
# 开发环境可用 ngrok 或 localhost
API_BASE_URL=http://localhost:9318
